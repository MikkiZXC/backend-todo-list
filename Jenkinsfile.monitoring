pipeline {
    // 1. АГЕНТ: Где выполнять пайплайн?
    // 'any' означает: используй любого доступного агента (в нашем случае - сам мастер Jenkins внутри Docker)
    agent any

    environment {
        // 2. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
        // Имя релиза в Helm
        RELEASE_NAME = 'monitoring-stack'
        // Неймспейс, куда ставим
        NAMESPACE = 'monitoring'
        // Путь к файлу values внутри workspace
        VALUES_FILE = 'helm/monitoring/values.yaml'
    }

    stages {
        // ЭТАП 1: ПОДГОТОВКА
        stage('🧹 Prepare Workspace') {
            steps {
                script {
                    echo "🧹 Cleaning workspace..."
                    // Очищаем папку, чтобы не было мусора от прошлых сборок
                    sh 'rm -rf ${WORKSPACE}/*'
                }
            }
        }

        // ЭТАП 2: ЗАГРУЗКА КОДА
        stage('📥 Checkout Code') {
            steps {
                echo "📥 Checking out code from Git..."
                // Скачиваем код из твоего репозитория
                // branch: 'add-k8s-manifests' — убедись, что ветка правильная!
                checkout scm
            }
        }

        // ЭТАП 3: ПРОВЕРКА ФАЙЛОВ
        stage('🔍 Validate Files') {
            steps {
                echo "🔍 Checking if values file exists..."
                script {
                    // Проверяем, существует ли файл values.yaml
                    if (!fileExists(VALUES_FILE)) {
                        error("❌ File ${VALUES_FILE} not found! Please create it.")
                    }
                    echo "✅ Values file found."
                    
                    // Опционально: можно сделать helm lint, если скачаем чарт локально
                    // Но для простоты пока пропустим
                }
            }
        }

        // ЭТАП 4: ДЕПЛОЙ ЧЕРЕЗ HELM
        stage('🚀 Deploy Monitoring Stack') {
            steps {
                echo "🚀 Starting Helm upgrade/install for ${RELEASE_NAME}..."
                
                sh """
                    helm upgrade --install ${RELEASE_NAME} \\
                        prometheus-community/kube-prometheus-stack \\
                        --namespace ${NAMESPACE} \\
                        --create-namespace \\
                        -f ${WORKSPACE}/${VALUES_FILE} \\
                        --wait --timeout=10m \\
                        --debug \\
                        --kube-insecure-skip-tls-verify
                """
            }
        }

        // ЭТАП 5: ПРОВЕРКА СТАТУСА
        stage('✅ Verify Deployment') {
            steps {
                echo "✅ Checking pods status in ${NAMESPACE}..."
                sh """
                    kubectl get pods -n ${NAMESPACE} --kube-insecure-skip-tls-verify
                    echo "🎉 Monitoring stack deployment finished!"
                """
            }
        }
    }

    // БЛОК POST: Выполняется всегда, независимо от успеха/неудачи
    post {
        success {
            echo "🟢 Pipeline succeeded! Monitoring is up."
        }
        failure {
            echo "🔴 Pipeline failed! Check logs above."
        }
        always {
            // Можно добавить очистку, если нужно
            echo "🏁 Pipeline execution completed."
        }
    }
}