pipeline {
    agent any

    environment {
        RELEASE_NAME = 'monitoring-stack'
        NAMESPACE = 'monitoring'
        VALUES_FILE = 'helm/monitoring/values.yaml'
        // Путь к папке .minikube на хосте, смонтированной в контейнер
        // Мы смонтировали её в /home/ikki/.minikube
        MINIKUBE_HOME = '/home/ikki/.minikube' 
    }

    stages {
        stage('📥 Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('🔧 Get Minikube IP & Fix Kubeconfig') {
            steps {
                script {
                    echo "🔧 Detecting Minikube IP..."
                    
                    // 1. Получаем IP миникаба, явно указывая домашнюю папку с профилями
                    // Флаг --bootstrapper=kubeadm стандартный, но главное указать home
                    def minikubeIp = sh(script: "MINIKUBE_HOME=${MINIKUBE_HOME} minikube ip", returnStdout: true).trim()
                    echo "Minikube IP is: ${minikubeIp}"

                    // 2. Генерируем kubeconfig, который будет работать из этого контейнера
                    // Мы используем minikube kubectl config view, чтобы получить правильный конфиг
                    sh """
                        MINIKUBE_HOME=${MINIKUBE_HOME} minikube update-context
                        # Копируем обновленный конфиг в workspace
                        cp ~/.kube/config ${WORKSPACE}/kubeconfig.tmp
                        # Заменяем сервер на прямой IP, чтобы избежать проблем с DNS host.docker.internal
                        sed -i "s|server: https://.*|server: https://${minikubeIp}:8443|g" ${WORKSPACE}/kubeconfig.tmp
                    """
                    
                    echo "✅ Kubeconfig prepared at ${WORKSPACE}/kubeconfig.tmp"
                }
            }
        }

        stage('🚀 Deploy Monitoring Stack') {
            steps {
                script {
                    echo "🚀 Deploying Helm chart..."
                    sh """
                        export KUBECONFIG=${WORKSPACE}/kubeconfig.tmp
                        helm upgrade --install ${RELEASE_NAME} \\
                            prometheus-community/kube-prometheus-stack \\
                            --namespace ${NAMESPACE} \\
                            --create-namespace \\
                            -f ${WORKSPACE}/${VALUES_FILE} \\
                            --wait --timeout=10m \\
                            --kube-insecure-skip-tls-verify
                    """
                }
            }
        }
    }

    post {
        success { echo "🟢 Monitoring deployed successfully!" }
        failure { echo "🔴 Deployment failed. Check logs." }
    }
}