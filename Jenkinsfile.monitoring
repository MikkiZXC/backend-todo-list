pipeline {
    agent any

    environment {
        RELEASE_NAME = 'monitoring-stack'
        NAMESPACE = 'monitoring'
        VALUES_FILE = 'helm/monitoring/values-monitoring.yaml' // Проверь имя файла!
    }

    stages {
        stage('📥 Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('🔧 Fix Kubeconfig for Minikube') {
            steps {
                script {
                    echo "🔧 Generating fresh kubeconfig from Minikube..."
                    // Minikube сама знает, как подключиться. 
                    // Мы сохраняем её конфиг во временную папку workspace
                    sh 'minikube update-context' 
                    sh 'cp ~/.kube/config ${WORKSPACE}/kubeconfig.tmp'
                    
                    // Проверяем, что файл создался
                    sh 'ls -la ${WORKSPACE}/kubeconfig.tmp'
                }
            }
        }

        stage('🚀 Deploy Monitoring Stack') {
            steps {
                script {
                    echo "🚀 Deploying with fixed kubeconfig..."
                    // Используем флаг --kubeconfig, чтобы указать Helm использовать наш свежий файл
                    sh """
                        export KUBECONFIG=${WORKSPACE}/kubeconfig.tmp
                        helm upgrade --install ${RELEASE_NAME} \\
                            prometheus-community/kube-prometheus-stack \\
                            --namespace ${NAMESPACE} \\
                            --create-namespace \\
                            -f ${WORKSPACE}/${VALUES_FILE} \\
                            --wait --timeout=10m \\
                            --kube-insecure-skip-tls-verify
                    """
                }
            }
        }
    }

    post {
        success { echo "🟢 Monitoring deployed!" }
        failure { echo "🔴 Deployment failed." }
    }
}