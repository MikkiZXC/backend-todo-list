pipeline {
    agent any

    environment {
        RELEASE_NAME = 'monitoring-stack'
        NAMESPACE = 'monitoring'
        VALUES_FILE = 'helm/monitoring/values-monitoring.yaml'
        // Путь к папке .minikube на хосте, смонтированной в контейнер
        // Мы смонтировали её в /home/ikki/.minikube
        MINIKUBE_HOME = '/home/ikki/.minikube' 
    }

    options {
        // Не запускать несколько сборок одновременно
        disableConcurrentBuilds()
    }

    stages {
        stage('📥 Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Check for Changes') {
            steps {
                script {
                    // Проверяем, были ли изменения в папке helm/monitoring
                    // Если нет - прерываем пайплайн успешно
                    def changes = sh(script: "git diff HEAD~1 HEAD --name-only | grep 'helm/monitoring/' || true", returnStdout: true).trim()
                    if (changes == "") {
                        echo "⏸ No changes in monitoring folder. Skipping deployment."
                        currentBuild.result = 'SUCCESS'
                        return // Прерываем выполнение
                    }
                    echo "✅ Changes detected in monitoring folder."
                }
            }
        }

        stage('🔧 Get Minikube IP & Fix Kubeconfig') {
            steps {
                script {
                    echo "🔧 Detecting Minikube IP..."
                    
                    // 1. Получаем IP миникаба
                    def minikubeIp = sh(script: "MINIKUBE_HOME=${MINIKUBE_HOME} minikube ip", returnStdout: true).trim()
                    echo "Minikube IP is: ${minikubeIp}"

                    // 2. Генерируем НОВЫЙ kubeconfig прямо в workspace (там можно писать)
                    // Мы используем команду config view, которая просто выводит текущий конфиг
                    // Но чтобы получить правильный контекст для этого IP, лучше использовать export
                    
                    sh """
                        # Создаем временный конфиг на основе текущего профиля
                        MINIKUBE_HOME=${MINIKUBE_HOME} minikube kubectl -- config view --raw > ${WORKSPACE}/kubeconfig.tmp
                        
                        # Заменяем сервер на прямой IP (порт 8443 стандартен для docker-driver)
                        sed -i "s|server: https://.*|server: https://${minikubeIp}:8443|g" ${WORKSPACE}/kubeconfig.tmp
                        
                        echo "✅ Kubeconfig generated at ${WORKSPACE}/kubeconfig.tmp"
                        cat ${WORKSPACE}/kubeconfig.tmp | grep server
                    """
                }
            }
        }

        stage('🚀 Deploy Monitoring Stack') {
            steps {
                script {
                    echo "🚀 Deploying Helm chart..."
                    sh """
                        export KUBECONFIG=${WORKSPACE}/kubeconfig.tmp
                        helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
                        helm repo update
                        helm upgrade --install ${RELEASE_NAME} \\
                            prometheus-community/kube-prometheus-stack \\
                            --namespace ${NAMESPACE} \\
                            --create-namespace \\
                            -f ${WORKSPACE}/${VALUES_FILE} \\
                            --wait --timeout=10m \\
                            --kube-insecure-skip-tls-verify
                    """
                }
            }
        }
    }

    post {
        success { echo "🟢 Monitoring deployed successfully!" }
        failure { echo "🔴 Deployment failed. Check logs." }
    }
}