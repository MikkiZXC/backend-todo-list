pipeline {
    agent any

    environment {
        RELEASE_NAME = 'monitoring-stack'
        NAMESPACE = 'monitoring'
        VALUES_FILE = 'helm/monitoring/values-monitoring.yaml'
    }

    stages {
        // 1. Явно скачиваем код. 
        // Jenkins уже сделал это один раз для чтения файла, 
        // но мы делаем это явно для надежности и доступа к GIT переменным.
        stage('📥 Checkout Code') {
            steps {
                echo "📥 Checking out code..."
                checkout scm
            }
        }

        // 2. Проверяем, что файл есть. 
        // Если его нет - ошибка сразу, не тратим время на helm.
        stage('🔍 Validate Files') {
            steps {
                script {
                    echo "🔍 Looking for ${VALUES_FILE} in ${WORKSPACE}"
                    // Команда ls поможет тебе увидеть, что реально лежит в папке, если файл не найдется
                    sh "ls -R helm/" 
                    
                    if (!fileExists(VALUES_FILE)) {
                        error("❌ File ${VALUES_FILE} is missing in Git!")
                    }
                    echo "✅ File found."
                }
            }
        }

        // 3. Деплоим
        stage('🚀 Deploy') {
            steps {
                sh """
                    helm upgrade --install ${RELEASE_NAME} \\
                        prometheus-community/kube-prometheus-stack \\
                        --namespace ${NAMESPACE} \\
                        --create-namespace \\
                        -f ${WORKSPACE}/${VALUES_FILE} \\
                        --wait --timeout=10m \\
                        --kube-insecure-skip-tls-verify
                """
            }
        }
    }
    
    post {
        success { echo "🟢 Success" }
        failure { echo "🔴 Failed" }
    }
}